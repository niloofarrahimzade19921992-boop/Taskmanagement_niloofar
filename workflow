/* نسخه آزمایشی گردش وظیفه — مستقل از بخش‌های قدیمی سامانه */
(()=>{'use strict';
const KEY='taskSystemTaskWorkflowV2',OLD='taskSystemWorkflowV1', $=id=>document.getElementById(id), esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),now=()=>new Date().toLocaleString('fa-IR');
let items=[];try{const v=JSON.parse(localStorage.getItem(KEY)||'[]');if(Array.isArray(v))items=v}catch{}
if(!localStorage.getItem(KEY)){try{let old=JSON.parse(localStorage.getItem(OLD)||'[]');if(Array.isArray(old)&&old.length){items=old.map(p=>({...p,stage:p.status==='draft'?'defined':p.status==='published'?'published':p.status==='pending'?'pending':p.status==='returned'?'returned':p.status==='closed'?'closed':'active',title:p.title||p.name,detail:p.description||'',owner:p.employer||'',reports:p.reports||[],history:p.history||[]}));localStorage.setItem(KEY,JSON.stringify(items))}}catch{}}
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(items));return true}catch{alert('حافظه مرورگر کافی نیست؛ خروجی JSON بگیرید.');return false}}, role=()=> $('wfRole').value, roleName={support:'پشتیبان',executor:'متولی',owner:'کارفرما'}, stages={defined:'تعریف‌شده',registered:'اطلاعات ثبت‌شده',published:'منتشرشده',pending:'در انتظار تأیید',returned:'برگشت برای اصلاح',active:'گزارش تأییدشده / فعال',closed:'خاتمه‌یافته'};
let tab='define';const id=()=>globalThis.crypto?.randomUUID?.()||String(Date.now())+Math.random().toString(36).slice(2),find=k=>items.find(x=>x.id===k);
function log(p,msg){p.history=p.history||[];p.history.unshift({date:now(),role:roleName[role()],msg})}
function modal(title,fields,cb){$('wfModalTitle').textContent=title;$('wfModalFields').innerHTML=fields;$('wfModal').hidden=false;$('wfModalForm').onsubmit=e=>{e.preventDefault();let d=Object.fromEntries(new FormData(e.currentTarget));if(cb(d)!==false){$('wfModal').hidden=true;render()}}}
function stageMatch(p){return tab==='all'||(tab==='define'&&p.stage==='defined')||(tab==='register'&&p.stage==='defined')||(tab==='publish'&&p.stage==='registered')||(tab==='update'&&['published','returned','active'].includes(p.stage))||(tab==='approve'&&p.stage==='pending')}
function render(){let r=role();$('wfRoleLabel').textContent=roleName[r];$('wfCreate').hidden=!(r==='support'||r==='owner')||tab!=='define';$('wfStageTitle').textContent={define:'تعریف وظیفه',register:'ثبت اطلاعات وظیفه',publish:'انتشار وظیفه و مستندات',update:'به‌روزرسانی وضعیت توسط متولی',approve:'تأیید یا برگشت کارفرما',all:'همه وظایف و سوابق'}[tab];
$('wfStats').innerHTML=`<div>کل وظایف<strong>${items.length}</strong></div><div>منتشرشده و فعال<strong>${items.filter(p=>['published','active','returned'].includes(p.stage)).length}</strong></div><div>منتظر تأیید<strong>${items.filter(p=>p.stage==='pending').length}</strong></div><div>خاتمه‌یافته<strong>${items.filter(p=>p.stage==='closed').length}</strong></div>`;
const q=$('wfSearch').value.trim();let filtered=items.filter(p=>stageMatch(p)&&(!q||[p.title,p.executor,p.owner].some(x=>String(x||'').includes(q))));
$('wfList').innerHTML=filtered.length?filtered.map(p=>{let a='',canCreate=['support','owner'].includes(r);if(p.stage==='defined'&&canCreate)a+=`<button data-act="register" data-id="${esc(p.id)}">ثبت اطلاعات وظیفه</button>`;if(p.stage==='registered'&&canCreate)a+=`<button data-act="publish" data-id="${esc(p.id)}">انتشار وظیفه</button>`;if(['published','returned','active'].includes(p.stage)&&r==='executor')a+=`<button data-act="report" data-id="${esc(p.id)}">${p.stage==='returned'?'اصلاح و ارسال مجدد':'ثبت / به‌روزرسانی وضعیت'}</button>`;if(p.stage==='pending'&&r==='owner')a+=`<button data-act="approve" data-id="${esc(p.id)}">تأیید گزارش</button><button class="wf-alt" data-act="return" data-id="${esc(p.id)}">برگشت برای اصلاح</button>`;if(p.stage==='active'&&r==='owner')a+=`<button data-act="close" data-id="${esc(p.id)}">خاتمه وظیفه</button>`;const last=p.reports?.at(-1);return `<article class="wf-project"><div class="wf-project-head"><h3>${esc(p.title)}</h3><span class="wf-tag">${stages[p.stage]||'نامشخص'}</span></div><p>متولی: ${esc(p.executor||'—')} | کارفرما: ${esc(p.owner||'—')} | پیشرفت تأییدشده: ${Number(p.progress)||0}٪</p><p>زمان‌بندی: ${esc(p.start||'—')} تا ${esc(p.end||'—')}</p><details><summary>جزئیات، منشور، گزارش‌ها و تاریخچه</summary><p><b>شرح:</b> ${esc(p.detail||'—')}</p><p><b>منشور:</b> ${esc(p.charter||'—')}</p><p><b>زمان‌بندی انتشار:</b> ${esc(p.schedule||'—')}</p><p><b>مستندات انتشار:</b> ${esc(p.document||'—')}</p>${last?`<p><b>آخرین گزارش:</b> ${esc(last.progress)}٪ — ${esc(last.summary)} | علت تأخیر: ${esc(last.delay||'—')} | سند: ${esc(last.document||'—')}</p>`:''}<ul>${(p.history||[]).map(h=>`<li>${esc(h.date)} — ${esc(h.role)}: ${esc(h.msg)}</li>`).join('')}</ul></details><div class="wf-actions">${a}</div></article>`}).join(''):'<div class="wf-empty">در این کارتابل فعلاً موردی وجود ندارد. برای شروع از «تعریف وظیفه» استفاده کنید یا نقش آزمایشی را تغییر دهید.</div>'}
function act(type,key){let p=find(key);if(!p)return;let r=role(),can=['support','owner'].includes(r);if(type==='register'&&can&&p.stage==='defined')modal('ثبت اطلاعات وظیفه',`<label>شرح کامل وظیفه <textarea name="detail" required>${esc(p.detail)}</textarea></label><label>نام متولی <input name="executor" required value="${esc(p.executor)}"></label><label>نام کارفرما <input name="owner" required value="${esc(p.owner)}"></label><label>تاریخ شروع <input name="start" value="${esc(p.start)}"></label><label>تاریخ پایان <input name="end" value="${esc(p.end)}"></label>`,d=>{Object.assign(p,d,{stage:'registered'});log(p,'اطلاعات وظیفه ثبت شد');return save()});
else if(type==='publish'&&can&&p.stage==='registered')modal('انتشار وظیفه',`<label>منشور (هدف و دامنه) <textarea name="charter" required>${esc(p.charter)}</textarea></label><label>زمان‌بندی اجرا <textarea name="schedule" required>${esc(p.schedule)}</textarea></label><label>نام فایل‌های مستندات (نسخه نمایشی) <input name="document" placeholder="charter.pdf, plan.xlsx"></label>`,d=>{Object.assign(p,d,{stage:'published'});log(p,'وظیفه همراه منشور و زمان‌بندی منتشر شد');return save()});
else if(type==='report'&&r==='executor'&&['published','returned','active'].includes(p.stage))modal('به‌روزرسانی وضعیت وظیفه',`<label>درصد پیشرفت <input name="progress" type="number" min="0" max="100" required value="${Number(p.progress)||0}"></label><label>آخرین وضعیت <textarea name="summary" required></textarea></label><label>دلایل تأخیر (در صورت وجود) <textarea name="delay"></textarea></label><label>نام سند دلیل تأخیر / گزارش <input name="document" placeholder="delay.pdf"></label>`,d=>{p.reports=p.reports||[];p.reports.push({...d,progress:Number(d.progress),status:'pending',date:now()});p.stage='pending';log(p,'گزارش '+d.progress+'٪ برای تأیید کارفرما ارسال شد');return save()});
else if(type==='approve'&&r==='owner'&&p.stage==='pending'){if(!confirm('گزارش تأیید شود؟'))return;let rep=p.reports.at(-1);rep.status='approved';p.progress=rep.progress;p.stage='active';log(p,'گزارش '+rep.progress+'٪ تأیید شد؛ وظیفه همچنان فعال است');save();render()}
else if(type==='return'&&r==='owner'&&p.stage==='pending')modal('برگشت برای اصلاح',`<label>توضیح اصلاحات موردنیاز <textarea name="reason" required></textarea></label>`,d=>{p.reports.at(-1).status='returned';p.stage='returned';log(p,'برگشت به متولی: '+d.reason);return save()});
else if(type==='close'&&r==='owner'&&p.stage==='active'){if(!confirm('آیا از خاتمه این وظیفه اطمینان دارید؟'))return;p.stage='closed';log(p,'وظیفه خاتمه یافت');save();render()}}
document.addEventListener('DOMContentLoaded',()=>{$('wfTabs').addEventListener('click',e=>{let b=e.target.closest('[data-stage]');if(!b)return;tab=b.dataset.stage;$('wfTabs').querySelectorAll('button').forEach(x=>x.classList.toggle('active',x===b));render()});$('wfRole').addEventListener('change',render);$('wfSearch').addEventListener('input',render);$('wfCreate').addEventListener('click',()=>{if(!['support','owner'].includes(role()))return;modal('تعریف وظیفه',`<label>عنوان وظیفه <input name="title" maxlength="150" required></label><label>توضیح اولیه <textarea name="detail"></textarea></label>`,d=>{let p={id:id(),title:d.title,detail:d.detail,stage:'defined',progress:0,reports:[],history:[]};log(p,'وظیفه تعریف شد');items.unshift(p);return save()})});$('wfList').addEventListener('click',e=>{let b=e.target.closest('[data-act]');if(b)act(b.dataset.act,b.dataset.id)});$('wfModalCancel').addEventListener('click',()=>{$('wfModal').hidden=true});$('wfExport').addEventListener('click',()=>{let u=URL.createObjectURL(new Blob([JSON.stringify(items,null,2)],{type:'application/json'})),a=document.createElement('a');a.href=u;a.download='task-workflow-backup.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),1500)});$('wfImport').addEventListener('change',async e=>{let f=e.target.files[0];if(!f)return;try{let d=JSON.parse(await f.text());if(!Array.isArray(d)||!d.every(x=>x.id&&x.title&&x.stage))throw Error();if(confirm('اطلاعات گردش کار با این فایل جایگزین شوند؟')){items=d;save();render()}}catch{alert('فایل پشتیبان معتبر نیست')}e.target.value=''});render()});
})();

